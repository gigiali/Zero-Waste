      "q1": "هل يمكنني الاختيار بين الاستلام والتوصيل؟",
      "a1": "نعم! يمكنك اختيار استلام طلبك مباشرة أو توصيله إلى موقعك مقابل رسوم بسيطة.",
      "q2": "كيف أتتبع طلبي؟",
      "a2": "بعد تقديم طلب، سيظهر شريط تتبع على الصفحة الرئيسية يعرض حالة طلبك في الوقت الفعلي.",
      "q3": "هل يمكنني إلغاء طلبي؟",
      "a3": "يمكنك إلغاء طلبك قبل قبوله من قبل البائع.",
      "q4": "ماذا لو ألغى البائع طلبي؟",
      "a4": "ستتلقى إشعارًا فوريًا وسيعكس شريط الطلب الإلغاء."
    },
    "payments": {
      "q1": "ما طرق الدفع المقبولة؟",
      "a1": "نقبل الدفع نقدًا عند التوصيل والاستلام. الدفع بالبطاقة متاح أيضًا.",
      "q2": "هل الأسعار نهائية أم توجد رسوم إضافية؟",
      "a2": "السعر المعروض يشمل سعر العرض المخفض. قد تُطبق رسوم توصيل. لا توجد رسوم مخفية."
    },
    "accounts": {
      "q1": "هل أحتاج إلى حساب لتصفح العروض؟",
      "a1": "يمكنك تصفح العروض بدون حساب. لتقديم الطلبات تحتاج إلى تسجيل الدخول.",
      "q2": "كيف أحدّث معلومات ملفي الشخصي؟",
      "a2": "انتقل إلى صفحة ملفك الشخصي من شريط التنقل وقم بتحديث بياناتك.",
      "q3": "كيف أحذف حسابي؟",
      "a3": "يمكنك حذف حسابك من صفحة إعدادات الملف الشخصي. هذا الإجراء نهائي."
    },
    "sustainability": {
      "q1": "كيف يساعد ZeroWaste البيئة؟",
      "a1": "كل طلب ينقذ طعامًا كان سيُهدر، مما يقلل انبعاثات ثاني أكسيد الكربون.",
      "q2": "ما هو قسم أثر الاستدامة؟",
      "a2": "يعرض عدد الوجبات التي أنقذتها وكمية ثاني أكسيد الكربون التي ساعدت في منعها والمبلغ الذي وفرته."
    },
    "businesses": {
      "q1": "كيف يمكن لعملي الانضمام إلى ZeroWaste؟",
      "a1": "سجل كبائع وأكمل إعداد عملك وقدّم مستنداتك للتحقق. بعد الموافقة يمكنك إدراج عروضك.",
      "q2": "ما أنواع الشركات التي يمكنها الانضمام؟",
      "a2": "المطاعم والمخابز والمقاهي والسوبر ماركت والفنادق وأي شركة غذائية لديها طعام فائض.",
      "q3": "كيف أدير عروضي وطلباتي؟",
      "a3": "من خلال لوحة تحكم البائع يمكنك إضافة عروضك وتعديلها وتتبع الطلبات الواردة."
